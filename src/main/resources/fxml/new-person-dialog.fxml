<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="net.gizmolab.library.librarymanagementsystemdesktop.controller.NewPersonDialogController"
      spacing="12.0" styleClass="form-dialog-container" prefWidth="480.0">
   <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
   <children>
      <GridPane hgap="10.0" vgap="8.0">
         <columnConstraints>
            <ColumnConstraints minWidth="170.0" />
            <ColumnConstraints hgrow="ALWAYS" />
         </columnConstraints>
         <children>
            <Label text="%user.firstName" GridPane.rowIndex="0" />
            <TextField fx:id="firstnameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="%user.lastName" GridPane.rowIndex="1" />
            <TextField fx:id="lastnameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="%catalog.qualifier" GridPane.rowIndex="2" />
            <TextField fx:id="qualifierField" promptText="%catalog.qualifier.prompt" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="%person.bornYear" GridPane.rowIndex="3" />
            <TextField fx:id="bornYearField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="%person.deathYear" GridPane.rowIndex="4" />
            <TextField fx:id="deathYearField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
         </children>
      </GridPane>
      <Label fx:id="errorLabel" styleClass="label-error" wrapText="true" visible="false" managed="false" />
      <VBox fx:id="duplicatesBox" spacing="6.0" visible="false" managed="false">
         <children>
            <Label text="%dialog.duplicate.person" styleClass="form-label" wrapText="true" />
            <ListView fx:id="duplicatesList" prefHeight="100.0" />
            <Label text="%dialog.duplicate.hint" wrapText="true" />
            <Button fx:id="useExistingButton" text="%dialog.useExisting" onAction="#handleUseExisting" disable="true" />
         </children>
      </VBox>
      <HBox alignment="CENTER_RIGHT" spacing="8.0">
         <children>
            <Button text="%common.cancel" onAction="#handleCancel" styleClass="button-outlined-primary" />
            <Button fx:id="createButton" text="%dialog.create" onAction="#handleCreate" styleClass="button-filled-primary" defaultButton="true" />
         </children>
      </HBox>
   </children>
</VBox>
