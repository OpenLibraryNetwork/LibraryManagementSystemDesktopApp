<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="net.gizmolab.library.librarymanagementsystemdesktop.controller.MagazineManagementController"
      styleClass="table-management-container" spacing="16.0">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="search-section">
         <children>
            <TextField fx:id="searchField" promptText="%common.search" styleClass="text-field" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="action-buttons">
               <children>
                  <Button fx:id="addButton" mnemonicParsing="false" styleClass="button,button-filled-primary" text="%magazine.addIssue" />
               </children>
            </HBox>
         </children>
      </HBox>

      <VBox styleClass="table-container,table-card" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tableView" styleClass="table-view" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="titleColumn" prefWidth="300.0" styleClass="table-column-name" text="%magazine.title" />
                  <TableColumn fx:id="issnColumn" prefWidth="120.0" text="%magazine.issn" />
                  <TableColumn fx:id="publisherColumn" prefWidth="260.0" styleClass="table-column-name" text="%magazine.publisher" />
                  <TableColumn fx:id="issuesColumn" prefWidth="100.0" styleClass="table-column-numeric" text="%magazine.issuesInLibrary" />
               </columns>
               <placeholder>
                  <Label text="%table.placeholder.no.magazines" />
               </placeholder>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="table-footer">
               <children>
                  <Label fx:id="statusLabel" styleClass="table-status" text="%status.items.total" />
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_RIGHT" spacing="4.0" styleClass="pagination-controls">
                     <children>
                        <Button fx:id="previousButton" disable="true" mnemonicParsing="false" onAction="#handlePrevious" styleClass="page-button" text="&#60;" />
                        <HBox fx:id="pageButtonsContainer" alignment="CENTER" spacing="4.0" />
                        <Button fx:id="nextButton" disable="true" mnemonicParsing="false" onAction="#handleNext" styleClass="page-button" text="&#62;" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox spacing="8.0" styleClass="table-container,table-card" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <children>
                  <Label fx:id="issuesTitleLabel" styleClass="form-label" text="%magazine.issuesOf" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="viewIssueButton" disable="true" mnemonicParsing="false" onAction="#handleViewIssue" styleClass="button,button-outlined-primary" text="%magazine.viewIssue" />
               </children>
            </HBox>
            <TableView fx:id="issuesTable" styleClass="table-view" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="issueNumberColumn" prefWidth="110.0" text="%magazine.issueNumber" />
                  <TableColumn fx:id="issuePeriodColumn" prefWidth="180.0" text="%magazine.period" />
                  <TableColumn fx:id="issueThemeColumn" prefWidth="320.0" text="%magazine.theme" />
                  <TableColumn fx:id="issueCopiesColumn" prefWidth="110.0" styleClass="table-column-numeric" text="%magazine.copies" />
               </columns>
               <placeholder>
                  <Label fx:id="issuesPlaceholder" text="%table.placeholder.no.issues" />
               </placeholder>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
