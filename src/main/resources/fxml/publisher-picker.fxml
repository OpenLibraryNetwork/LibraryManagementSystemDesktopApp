<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="net.gizmolab.library.librarymanagementsystemdesktop.controller.picker.PublisherPickerController"
      spacing="6.0">
   <children>
      <HBox spacing="8.0">
         <children>
            <TextField fx:id="searchField" promptText="%picker.publisher.search" HBox.hgrow="ALWAYS" />
            <Button text="%picker.publisher.new" onAction="#handleNewPublisher" />
         </children>
      </HBox>
      <ListView fx:id="suggestionsList" prefHeight="90.0" />
      <HBox spacing="8.0" alignment="CENTER_LEFT">
         <children>
            <Label fx:id="selectedLabel" text="—" HBox.hgrow="ALWAYS" />
            <Button fx:id="clearButton" text="%picker.clear" onAction="#handleClear" disable="true" />
         </children>
      </HBox>
      <Label fx:id="statusLabel" styleClass="text-muted" wrapText="true" />
   </children>
</VBox>
