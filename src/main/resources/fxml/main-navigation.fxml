<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.gizmolab.library.librarymanagementsystemdesktop.controller.MainNavigationController">
   
   <left>
      <!-- Sidebar Navigation -->
      <VBox styleClass="sidebar-navigation,nav-sidebar" prefWidth="250.0" spacing="5.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <!-- Logo Placeholder -->
         <Pane fx:id="logoPlaceholder" styleClass="logo-placeholder" prefHeight="80.0" maxHeight="80.0" minHeight="80.0">
            <children>
               <ImageView fx:id="logoView" fitHeight="70.0" preserveRatio="true" layoutX="10.0" layoutY="5.0">
                  <image>
                     <Image url="@/static/assets/logo.png" />
                  </image>
               </ImageView>
            </children>
            <VBox.margin>
               <Insets bottom="20.0" top="10.0" />
            </VBox.margin>
         </Pane>
         
         <!-- Navigation Buttons -->
         <Button fx:id="dashboardButton" styleClass="sidebar-button,nav-item" text="%navigation.dashboard" onAction="#onDashboardClicked" maxWidth="Infinity" graphicTextGap="10.0" />
         <Button fx:id="usersButton" styleClass="sidebar-button,nav-item" text="%navigation.users" onAction="#onUsersClicked" maxWidth="Infinity" graphicTextGap="10.0" />
         <Button fx:id="borrowsButton" styleClass="sidebar-button,nav-item" text="%navigation.borrows" onAction="#onBorrowsClicked" maxWidth="Infinity" graphicTextGap="10.0" />
         <Button fx:id="publicationsButton" styleClass="sidebar-button,nav-item" text="%navigation.books" onAction="#onPublicationsClicked" maxWidth="Infinity" graphicTextGap="10.0" />
         <Button fx:id="brochuresButton" styleClass="sidebar-button,nav-item" text="%navigation.brochures" onAction="#onBrochuresClicked" maxWidth="Infinity" graphicTextGap="10.0" />
         <Button fx:id="magazinesButton" styleClass="sidebar-button,nav-item" text="%navigation.magazines" onAction="#onMagazinesClicked" maxWidth="Infinity" graphicTextGap="10.0" />
         <Button fx:id="authorsButton" styleClass="sidebar-button,nav-item" text="%navigation.authors" onAction="#onAuthorsClicked" maxWidth="Infinity" graphicTextGap="10.0" />
         <Button fx:id="publishersButton" styleClass="sidebar-button,nav-item" text="%navigation.publishers" onAction="#onPublishersClicked" maxWidth="Infinity" graphicTextGap="10.0" />
         
         <!-- Spacer to push bottom elements down -->
         <Region VBox.vgrow="ALWAYS" />
         
         <!-- Language Selector Button -->
         <HBox fx:id="languageSelectorContainer" styleClass="language-selector" alignment="CENTER_LEFT" spacing="10.0">
            <VBox.margin>
               <Insets top="10.0" bottom="10.0" left="10.0" right="10.0" />
            </VBox.margin>
            <Button fx:id="languageButton" styleClass="sidebar-button, language-button-compact" onAction="#onLanguageButtonClicked" />
            <Button fx:id="logoutButton" styleClass="sidebar-button" text="%navigation.logout" onAction="#onLogoutClicked" />
         </HBox>
      </VBox>
   </left>
   
   <center>
      <!-- Content Area - Dynamic FXML Loading -->
      <StackPane fx:id="contentArea" styleClass="content-area">
         <!-- Welcome view will be loaded here initially -->
         <VBox alignment="CENTER" spacing="20.0" styleClass="welcome-container">
            <Label fx:id="welcomeLabel" styleClass="welcome-title" text="%welcome.title" />
            <Label fx:id="welcomeMessageLabel" styleClass="welcome-message" text="%welcome.message" />
         </VBox>
      </StackPane>
   </center>
   
   <bottom>
      <!-- Status Bar -->
      <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10.0">
         <padding>
            <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
         </padding>
         <Label fx:id="statusLabel" styleClass="status-label" text="%status.ready" />
         <Region HBox.hgrow="ALWAYS" />
         <Label fx:id="connectionStatusLabel" styleClass="connection-status" text="%status.database.connected" />
      </HBox>
   </bottom>
</BorderPane>