<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.gizmolab.library.librarymanagementsystemdesktop.controller.AuthorFormController" spacing="16.0" styleClass="form-dialog-container" prefWidth="450.0" minWidth="450.0" maxWidth="450.0">
   <children>
      <!-- Form Content -->
      <GridPane hgap="12" vgap="10" styleClass="card-content">
         <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="120.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
         <children>
            <!-- First Name Field -->
            <Label text="%user.firstName" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <VBox spacing="4.0" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0">
               <children>
                  <TextField fx:id="firstNameField" promptText="%prompt.enter.firstname" styleClass="text-field" />
                  <Label fx:id="firstNameErrorLabel" styleClass="label-error" visible="false" managed="false" />
               </children>
            </VBox>

            <!-- Last Name Field -->
            <Label text="%user.lastName" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <VBox spacing="4.0" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <TextField fx:id="lastNameField" promptText="%prompt.enter.lastname" styleClass="text-field" />
                  <Label fx:id="lastNameErrorLabel" styleClass="label-error" visible="false" managed="false" />
               </children>
            </VBox>
         </children>
      </GridPane>

      <!-- Warning Alert Box for Errors -->
      <HBox fx:id="errorContainer" alignment="CENTER_LEFT" spacing="10.0" styleClass="warning-box" visible="false" managed="false">
         <children>
            <StackPane styleClass="warning-icon-container" minWidth="20.0" prefWidth="20.0">
               <children>
                  <Region styleClass="warning-icon-shape" />
               </children>
            </StackPane>
            <Label fx:id="errorLabel" styleClass="warning-message" text="" wrapText="true" HBox.hgrow="ALWAYS" minWidth="0.0" />
         </children>
      </HBox>

      <!-- Action Buttons -->
      <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="card-actions">
         <padding>
            <Insets top="16.0" />
         </padding>
         <children>
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" styleClass="button-outlined-primary" text="%common.cancel" />
            <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" styleClass="button-filled-primary" text="%common.save" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
</VBox>