<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.gizmolab.library.librarymanagementsystemdesktop.controller.BorrowHistoryModalController" spacing="12.0" styleClass="table-management-container">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>

      <!-- Search Section -->
      <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="search-section">
         <children>
            <TextField fx:id="searchField" promptText="%borrowHistory.search.prompt" styleClass="text-field" />
            <ComboBox fx:id="statusFilterComboBox" promptText="%borrowHistory.filter.all" styleClass="combo-box" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="action-buttons">
               <children>
                  <Button fx:id="returnBookButton" disable="true" mnemonicParsing="false" onAction="#handleReturnBook" styleClass="button,button-outlined-primary" text="%borrowHistory.returnBook" />
               </children>
            </HBox>
         </children>
      </HBox>

      <!-- Table Section -->
      <VBox styleClass="table-container,table-card" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="historyTable" styleClass="table-view" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="bookTitleColumn" prefWidth="200.0" text="%borrowHistory.column.bookTitle" />
                  <TableColumn fx:id="authorColumn" prefWidth="160.0" text="%borrowHistory.column.author" />
                  <TableColumn fx:id="copyNumberColumn" prefWidth="90.0" text="%borrowHistory.column.copyNumber" />
                  <TableColumn fx:id="borrowDateColumn" prefWidth="110.0" text="%borrowHistory.column.borrowDate" />
                  <TableColumn fx:id="returnDateColumn" prefWidth="110.0" text="%borrowHistory.column.returnDate" />
                  <TableColumn fx:id="statusColumn" prefWidth="100.0" text="%borrowHistory.column.status" />
               </columns>
               <placeholder>
                  <Label text="%common.loading" />
               </placeholder>
            </TableView>

            <!-- Pagination Footer -->
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="table-footer">
               <children>
                  <Label fx:id="tableStatusLabel" styleClass="table-status" />
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_RIGHT" spacing="4.0" styleClass="pagination-controls">
                     <children>
                        <Button fx:id="previousButton" disable="true" mnemonicParsing="false" onAction="#handlePrevious" styleClass="page-button" text="&#60;" />
                        <HBox fx:id="pageButtonsContainer" alignment="CENTER" spacing="4.0" />
                        <Button fx:id="nextButton" disable="true" mnemonicParsing="false" onAction="#handleNext" styleClass="page-button" text="&#62;" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Close Button -->
      <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="card-actions">
         <children>
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleClose" styleClass="button-outlined-primary" text="%borrowHistory.close" />
         </children>
      </HBox>
   </children>
</VBox>
