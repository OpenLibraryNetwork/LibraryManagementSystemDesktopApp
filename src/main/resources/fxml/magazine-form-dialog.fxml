<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.gizmolab.library.librarymanagementsystemdesktop.controller.MagazineFormController" spacing="16.0" styleClass="form-dialog-container" prefWidth="450.0" minWidth="450.0" maxWidth="450.0">
   <children>
      <GridPane hgap="12" vgap="10" styleClass="card-content">
         <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="120.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" />
         </columnConstraints>
         <children>
            <!-- Title -->
            <Label text="%magazine.title" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <VBox spacing="4.0" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0">
               <children>
                  <TextField fx:id="titleField" promptText="%prompt.enter.magazine.title" styleClass="text-field" />
                  <Label fx:id="titleErrorLabel" styleClass="label-error" visible="false" managed="false" wrapText="true" />
               </children>
            </VBox>

            <!-- ISSN -->
            <Label text="%magazine.issn" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <VBox spacing="4.0" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <TextField fx:id="issnField" promptText="%prompt.enter.issn" styleClass="text-field" />
                  <Label fx:id="issnErrorLabel" styleClass="label-error" visible="false" managed="false" wrapText="true" />
               </children>
            </VBox>

            <!-- Publisher -->
            <Label text="%magazine.publisher" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <VBox spacing="4.0" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <ComboBox fx:id="publisherComboBox" promptText="%prompt.select.publisher" styleClass="combo-box" maxWidth="Infinity" />
                  <Label fx:id="publisherErrorLabel" styleClass="label-error" visible="false" managed="false" wrapText="true" />
               </children>
            </VBox>
         </children>
      </GridPane>

      <!-- Warning Alert Box for Errors -->
      <HBox fx:id="errorContainer" alignment="CENTER_LEFT" spacing="10.0" styleClass="warning-box" visible="false" managed="false">
         <children>
            <StackPane styleClass="warning-icon-container" minWidth="20.0" prefWidth="20.0">
               <children>
                  <Region styleClass="warning-icon-shape" />
               </children>
            </StackPane>
            <Label fx:id="errorLabel" styleClass="warning-message" text="" wrapText="true" HBox.hgrow="ALWAYS" minWidth="0.0" />
         </children>
      </HBox>

      <!-- Action Buttons -->
      <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="card-actions">
         <padding>
            <Insets top="16.0" />
         </padding>
         <children>
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" styleClass="button-outlined-primary" text="%common.cancel" />
            <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" styleClass="button-filled-primary" text="%common.save" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
</VBox>
