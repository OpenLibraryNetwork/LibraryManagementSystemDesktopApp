<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="net.gizmolab.library.librarymanagementsystemdesktop.controller.PublicationFormController"
      spacing="16.0" styleClass="form-dialog-container" prefWidth="500.0" minWidth="500.0" maxWidth="500.0">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>

      <!-- Type Selection -->
      <HBox spacing="10" alignment="CENTER_LEFT">
         <Label text="%publication.type" styleClass="form-label" minWidth="100"/>
         <ComboBox fx:id="typeComboBox" promptText="%publication.type.prompt" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
      </HBox>

      <!-- ISBN Section (visible only for Βιβλίο) -->
      <VBox fx:id="isbnSection" spacing="8" visible="false" managed="false">
         <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="%book.isbn" styleClass="form-label" minWidth="100"/>
            <TextField fx:id="isbnField" promptText="%publication.isbn.prompt" HBox.hgrow="ALWAYS"/>
            <Button fx:id="searchBiblionetButton" text="%publication.isbn.search" onAction="#handleSearchBiblionet" styleClass="button-outlined-primary"/>
         </HBox>

         <!-- Biblionet Preview -->
         <VBox fx:id="biblionetPreviewSection" spacing="4" visible="false" styleClass="card-content">
            <padding><Insets top="8" bottom="8" left="12" right="12"/></padding>
            <Label text="%publication.biblionet.result" style="-fx-font-weight: bold;"/>
            <HBox spacing="4">
               <Label text="%publication.biblionet.title" minWidth="70"/>
               <Label fx:id="previewTitleLabel" wrapText="true"/>
            </HBox>
            <HBox spacing="4">
               <Label text="%publication.biblionet.author" minWidth="70"/>
               <Label fx:id="previewAuthorLabel"/>
            </HBox>
            <HBox spacing="4">
               <Label text="%publication.biblionet.publisher" minWidth="70"/>
               <Label fx:id="previewPublisherLabel"/>
            </HBox>
         </VBox>
      </VBox>

      <!-- Common Fields -->
      <GridPane hgap="12" vgap="10">
         <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="100.0" prefWidth="100.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="250.0"/>
         </columnConstraints>
         <children>
            <Label text="%publication.title" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="titleField" promptText="%publication.title.prompt" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="%publication.pages" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="pagesField" promptText="%publication.pages.prompt" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="%publication.year" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="yearField" promptText="%publication.year.prompt" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
         </children>
      </GridPane>

      <!-- Periodical Section (visible only for Περιοδικό) -->
      <VBox fx:id="periodicalSection" spacing="8" visible="false" managed="false">
         <Label text="%publication.periodical.section" style="-fx-font-weight: bold;"/>
         <GridPane hgap="12" vgap="10">
            <columnConstraints>
               <ColumnConstraints hgrow="NEVER" minWidth="100.0" prefWidth="100.0"/>
               <ColumnConstraints hgrow="ALWAYS" minWidth="200.0"/>
            </columnConstraints>
            <children>
               <Label text="%publication.magazine" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
               <ComboBox fx:id="magazineComboBox" promptText="%publication.magazine.prompt" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

               <Label text="%publication.issueNumber" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
               <TextField fx:id="issueNumberField" promptText="%publication.issueNumber.prompt" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

               <Label text="%publication.monthYear" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
               <TextField fx:id="monthYearField" promptText="%publication.monthYear.prompt" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </children>
         </GridPane>
      </VBox>

      <!-- Copies Section -->
      <VBox fx:id="copiesSection" spacing="8">
         <Label text="%publication.copies" style="-fx-font-weight: bold;"/>
         <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="%publication.copies.quantity" minWidth="80"/>
            <Spinner fx:id="copiesSpinner" prefWidth="80"/>
            <Label text="%publication.copies.condition" minWidth="80"/>
            <ComboBox fx:id="conditionComboBox" prefWidth="120"/>
         </HBox>
      </VBox>

      <!-- Action Buttons -->
      <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="card-actions">
         <padding><Insets top="16.0"/></padding>
         <children>
            <Button fx:id="cancelButton" text="%common.cancel" onAction="#handleCancel" styleClass="button-outlined-primary"/>
            <Button fx:id="saveButton" text="%common.save" onAction="#handleSave" styleClass="button-filled-primary"/>
         </children>
      </HBox>

   </children>
</VBox>
